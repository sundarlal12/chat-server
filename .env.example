# Copy to .env and fill in real values on the server - never commit .env.

PORT=3000

# Auth is delegated entirely to the PHP API (see src/auth.js/src/phpApi.js)
# rather than reimplemented here, so no JWT_SECRET is needed.
PHP_API_BASE_URL=https://papa777.sbs

# Used to build attachment download URLs (upload-chat-attachment's
# response) and for CORS reference.
PUBLIC_BASE_URL=https://ca-api.papa777.sbs

# --- Database (Railway MySQL plugin, or any MySQL) --------------------
# Chat data (topics/tickets/messages) and attachment file blobs are
# persisted here - see migrate.js for the schema, auto-run on startup.
#
# Option A: a single connection URL - this is what Railway's MySQL plugin
# provides (MYSQL_URL for the private in-project network, MYSQL_PUBLIC_URL
# for external access e.g. local dev). Just reference it in this service's
# Railway variables as MYSQL_URL=${{MySQL.MYSQL_URL}} (adjust the plugin
# name if yours differs) - no other DB_* vars needed.
# MYSQL_URL=mysql://user:pass@host:port/database

# Option B: discrete vars (used if no *_URL var is set) - e.g. for local
# development against a plain MySQL install.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_local_test

# Overrides the placeholder support-agent identity every new ticket is
# auto-assigned to (there's no admin panel yet to pick a real one) - see
# store.js's DEFAULT_AGENT.
# DEFAULT_AGENT_ID=
# DEFAULT_AGENT_USERNAME=
# DEFAULT_AGENT_FULLNAME=
