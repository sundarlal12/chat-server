# Copy to .env and fill in real values on the server - never commit .env.

PORT=3000

# No database - this service keeps chat state in memory only (lost on
# restart/redeploy, kept otherwise - see src/store.js). Auth is delegated
# entirely to the PHP API (see src/auth.js/src/phpApi.js), so the only
# required config is where that API lives.
PHP_API_BASE_URL=https://papa777.sbs

# Used for CORS/reference only - not required for the service to function.
PUBLIC_BASE_URL=https://ca-api.papa777.sbs
