# Copy to .env and fill in real values on the server - never commit .env.

PORT=3000

# Must be the EXACT same secret as JWT_SECRET in the PHP api/_config.php on
# the papa777.sbs box - tokens are issued there (mpin-login/fingerprint-login)
# and verified here. A mismatch means every real client token gets rejected.
JWT_SECRET=

# Same MySQL database the PHP API uses (u928764531_papa777_db). Requires
# Hostinger's "Remote MySQL" access list to include this server's public IP
# (hPanel -> Databases -> Remote MySQL -> Add Access Host), otherwise every
# connection attempt will hang/refuse from outside their network.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Used to build absolute URLs where needed (none currently - file uploads
# still go through the existing PHP endpoint, see README.md) and for CORS.
PUBLIC_BASE_URL=https://ca-api.papa777.sbs

# The PHP API base - used only for the file-upload step (send-file-message
# still uploads via the existing, already-deployed PHP endpoint rather than
# this service storing/serving files itself).
PHP_API_BASE_URL=https://papa777.sbs
